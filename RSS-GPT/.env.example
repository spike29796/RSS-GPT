# 本地跑管线用的 LLM 配置（OpenAI 兼容协议）
# 用法：复制本文件为 .env，填好后在 RSS-GPT/ 下跑 `python run_local.py`
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# 注意：.env 已被 gitignore，真实 key 不会进仓库。

# --- 本地 LLM 端点（必填，KEY 自己填）---
# Ollama：http://127.0.0.1:11434/v1（先 `ollama serve`）
# LM Studio：http://127.0.0.1:1234/v1
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# 本地跑的模型名（必填，自己填，如 qwen2.5:7b / llama3.1:8b）
CUSTOM_MODEL=

# API Key：本地 LLM 通常不校验，可留空或填任意占位（如 ollama）；要填自己填
OPENAI_API_KEY=

# 你的 GitHub 用户名（用于 Pages 部署 URL https://<U_NAME>.github.io/RSS-GPT/）
U_NAME=spike29796
